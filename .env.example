# =============================================================================
# wp-audit-win environment configuration
# Copy to .env (install.sh does this for you) and fill in / generate secrets.
# NEVER commit the real .env.
# =============================================================================

# --- Core ---
WPSEC_ENV=production
WPSEC_LOG_LEVEL=INFO
# Public URL the dashboard is reached at (used for CORS + links in reports)
WPSEC_PUBLIC_URL=https://localhost

# --- Secrets (install.sh generates these with `openssl rand`) ---
# JWT signing key. 64+ random chars.
WPSEC_SECRET_KEY=change-me-run-install-sh
# Fernet key for encrypting stored credentials at rest. 32 url-safe base64 bytes.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WPSEC_CREDENTIAL_KEY=change-me-run-install-sh

# Access/refresh token lifetimes
WPSEC_ACCESS_TOKEN_MINUTES=30
WPSEC_REFRESH_TOKEN_DAYS=7

# --- PostgreSQL ---
POSTGRES_USER=wpsec
POSTGRES_PASSWORD=change-me-run-install-sh
POSTGRES_DB=wpsec
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-run-install-sh

# --- MinIO (evidence / artifact object storage) ---
MINIO_ROOT_USER=wpsec
MINIO_ROOT_PASSWORD=change-me-run-install-sh
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=wpsec-evidence
MINIO_SECURE=false

# --- Initial administrator (install.sh / bootstrap creates this user once) ---
WPSEC_ADMIN_EMAIL=admin@example.com
WPSEC_ADMIN_PASSWORD=change-me-run-install-sh

# --- Worker tuning ---
WPSEC_WORKER_CONCURRENCY=2
# Global safety cap: hard ceiling on scan intensity regardless of per-target profile.
# One of: passive, safe, standard, aggressive
WPSEC_MAX_INTENSITY=standard

# --- Optional external data (all free/public; no paid keys required) ---
# WPScan API token is OPTIONAL. The wpscan worker runs fully without it (local
# enumeration); a token only enriches vulnerability intelligence. Leave blank.
WPSCAN_API_TOKEN=
# NVD API key is OPTIONAL (raises rate limits only). Leave blank to use the
# public unauthenticated endpoint.
NVD_API_KEY=

# --- Frontend ---
# URL the browser uses to reach the API (through the reverse proxy).
NEXT_PUBLIC_API_BASE=/api
